<UserControl x:Class="DynamicIsland.Views.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="380"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Width="46" Height="46" VerticalAlignment="Center">
            <Border CornerRadius="12" Background="#22FFFFFF">
                <Path Data="{StaticResource IconMusic}" Style="{StaticResource Icon}"
                      Width="20" Height="20"
                      Stroke="{StaticResource TextSecondaryBrush}" />
            </Border>
            <Border CornerRadius="12">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Track.Artwork}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>

        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Track.DisplayTitle}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Track.DisplayArtist}"
                       FontSize="11"
                       Margin="0,2,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                    Command="{Binding PreviousCommand}" ToolTip="Предыдущий">
                <Path Data="{StaticResource IconPrev}" Style="{StaticResource Icon}" Width="15" Height="15" />
            </Button>

            <Button Style="{StaticResource IconButton}" Width="32" Height="32" Margin="4,0"
                    Command="{Binding TogglePlayPauseCommand}" ToolTip="Play/Pause">
                <Grid>
                    <Path Data="{StaticResource IconPause}" Style="{StaticResource Icon}" Width="16" Height="16"
                          Visibility="{Binding Track.IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                    <Path Data="{StaticResource IconPlay}" Style="{StaticResource Icon}" Width="16" Height="16"
                          Visibility="{Binding Track.IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Button>

            <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                    Command="{Binding NextCommand}" ToolTip="Следующий">
                <Path Data="{StaticResource IconNext}" Style="{StaticResource Icon}" Width="15" Height="15" />
            </Button>

            <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="2,0,0,0"
                    Command="{Binding ToggleMuteCommand}" ToolTip="Включить/выключить звук">
                <Grid>
                    <Path Data="{StaticResource IconVolume}" Style="{StaticResource Icon}" Width="16" Height="16"
                          Visibility="{Binding IsMuted, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Path Data="{StaticResource IconVolumeMuted}" Style="{StaticResource Icon}" Width="16" Height="16"
                          Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
