<UserControl x:Class="DynamicIsland.Views.TranslatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:DynamicIsland.Models"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="380"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Language row -->
        <Grid Grid.Row="0" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Width="66"
                      VerticalAlignment="Center"
                      Style="{StaticResource IslandCombo}"
                      ItemsSource="{Binding Languages}"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding SourceLanguage, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Column="1"
                    Style="{StaticResource IconButton}"
                    Width="28" Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ToolTip="Поменять языки"
                    Command="{Binding SwapLanguagesCommand}">
                <Path Data="{StaticResource IconSwap}" Style="{StaticResource Icon}" Width="15" Height="15" />
            </Button>

            <ComboBox Grid.Column="2"
                      Width="66"
                      VerticalAlignment="Center"
                      Style="{StaticResource IslandCombo}"
                      ItemsSource="{Binding Languages}"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding TargetLanguage, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}" Margin="0,9,0,9" />

        <!-- Source text -->
        <TextBox Grid.Row="2"
                 MinHeight="40"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="13"
                 PreviewKeyDown="OnInputPreviewKeyDown"
                 Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Вставить из буфера" Command="{Binding PasteFromClipboardCommand}" />
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>

        <!-- Separator -->
        <Border Grid.Row="3"
                Height="1"
                Background="{StaticResource DividerBrush}"
                Margin="0,8,0,8" />

        <!-- Translation with the copy action in the bottom-right corner -->
        <Grid Grid.Row="4">
            <TextBox IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Padding="0,0,34,18"
                     Text="{Binding Output, Mode=OneWay}" />

            <TextBlock Text="…"
                       FontSize="12"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,2"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding Error}"
                       FontSize="10"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="0,0,34,2"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#FFE08A8A">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Style="{StaticResource IconButton}"
                    Width="28" Height="28"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,-4,-6"
                    ToolTip="Копировать перевод"
                    Command="{Binding CopyResultCommand}">
                <Path Data="{StaticResource IconCopy}" Style="{StaticResource Icon}" Width="15" Height="15" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
