<UserControl x:Class="DynamicIsland.Views.ColorPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DynamicIsland.Views"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="440"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="2,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Swatch + hex + copy -->
            <Grid Grid.Row="0" Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="12"
                        Background="{Binding SwatchBrush}"
                        BorderBrush="#26FFFFFF" BorderThickness="1" />

                <TextBox Grid.Column="1"
                         Style="{StaticResource FieldTextBox}"
                         Margin="10,0,8,0"
                         VerticalAlignment="Center"
                         Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ApplyHexCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2"
                        Style="{StaticResource IconButton}"
                        Width="30" Height="30"
                        ToolTip="Скопировать HEX"
                        Command="{Binding CopyHexCommand}">
                    <Path Data="{StaticResource IconCopy}" Style="{StaticResource Icon}" Width="15" Height="15" />
                </Button>
            </Grid>

            <!-- RGB -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RGB" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding RgbText}" FontSize="13" />
            </Grid>

            <!-- HSL -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HSL" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding HslText}" FontSize="13" />
            </Grid>

            <!-- Copy formats -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <Button Content="HEX" Command="{Binding CopyHexCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveFormat}" Value="HEX">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="RGB" Command="{Binding CopyRgbCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveFormat}" Value="RGB">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="HSL" Command="{Binding CopyHslCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveFormat}" Value="HSL">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="CSS" Command="{Binding CopyCssCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveFormat}" Value="CSS">
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Eyedropper -->
            <Button Grid.Row="4"
                    Style="{StaticResource TextButton}"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0"
                    Command="{Binding PickCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconColorPicker}" Style="{StaticResource Icon}" Width="15" Height="15" />
                    <TextBlock Text="Взять с экрана" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <views:ColorWheel Grid.Column="1"
                          VerticalAlignment="Center"
                          Hue="{Binding Hue, Mode=TwoWay}"
                          Saturation="{Binding Saturation, Mode=TwoWay}"
                          Value="{Binding Value, Mode=TwoWay}" />
    </Grid>
</UserControl>
