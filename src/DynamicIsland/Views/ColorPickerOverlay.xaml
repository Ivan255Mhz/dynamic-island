<Window x:Class="DynamicIsland.Views.ColorPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a color"
        Width="180" Height="196"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="#00000000"
        FontFamily="{StaticResource UiFont}">
    <StackPanel>
        <!-- Live zoom around the cursor (Figma-like) -->
        <Border x:Name="Magnifier"
                Width="130" Height="130"
                HorizontalAlignment="Left"
                CornerRadius="10"
                Background="#FF000000"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Image x:Name="MagnifierImage"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Rectangle x:Name="MagnifierCenter"
                           Width="10" Height="10"
                           Stroke="White" StrokeThickness="1.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Swatch + hex -->
        <Border x:Name="Info"
                Background="#E6101012"
                CornerRadius="10"
                Padding="10,8"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                HorizontalAlignment="Left"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Preview"
                        Width="34" Height="34"
                        CornerRadius="8"
                        Margin="0,0,10,0"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1" />
                <TextBlock x:Name="HexLabel"
                           Foreground="#FFF3F3F5"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
