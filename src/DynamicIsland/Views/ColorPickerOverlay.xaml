<Window x:Class="DynamicIsland.Views.ColorPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a color"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        AllowsTransparency="False"
        Background="#FF101012"
        Cursor="Cross"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Image x:Name="ScreenImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Canvas x:Name="Layer">
            <Border x:Name="Magnifier"
                    Width="156" Height="156"
                    CornerRadius="10"
                    BorderBrush="#AAFFFFFF"
                    BorderThickness="1"
                    Background="#FF000000"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="MagnifierImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Rectangle x:Name="MagnifierCenter"
                               Width="12" Height="12"
                               Stroke="White" StrokeThickness="1.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border x:Name="Info"
                    Background="#CC101012"
                    CornerRadius="10"
                    Padding="12,8"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="Preview"
                            Width="34" Height="34"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1" />

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="HexLabel" Foreground="#FFF3F3F5" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="RgbLabel" Foreground="#99FFFFFF" FontSize="11" Margin="0,2,0,0" />
                        <TextBlock Text="ЛКМ — выбрать · Esc — отмена"
                                   Foreground="#66FFFFFF" FontSize="10" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
