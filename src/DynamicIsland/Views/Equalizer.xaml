<UserControl x:Class="DynamicIsland.Views.Equalizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="16" d:DesignWidth="22"
             Width="22" Height="16">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="16">
        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1,0"
                   Fill="{StaticResource TextPrimaryBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar0Scale" ScaleY="0.3" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1,0"
                   Fill="{StaticResource TextPrimaryBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar1Scale" ScaleY="0.3" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1,0"
                   Fill="{StaticResource TextPrimaryBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar2Scale" ScaleY="0.3" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1,0"
                   Fill="{StaticResource TextPrimaryBrush}" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="Bar3Scale" ScaleY="0.3" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </StackPanel>
</UserControl>
