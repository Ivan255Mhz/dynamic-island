<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DynamicIsland.Views"
        mc:Ignorable="d"
        Title="Dynamic Island"
        Width="480" Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Border x:Name="Island"
                Width="210" Height="40"
                CornerRadius="0,0,20,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0"
                Background="{StaticResource IslandBrush}"
                ClipToBounds="True"
                MouseEnter="OnIslandMouseEnter"
                MouseLeave="OnIslandMouseLeave"
                MouseLeftButtonUp="OnIslandClick"
                PreviewMouseRightButtonUp="OnIslandRightButtonUp">
            <Border.ContextMenu>
                <ContextMenu Opened="OnIslandMenuOpening">
                    <MenuItem Header="Расположение">
                        <MenuItem Header="Сверху" Tag="Top" IsCheckable="True" Click="OnDockClick" />
                        <MenuItem Header="Снизу (над панелью)" Tag="Bottom" IsCheckable="True" Click="OnDockClick" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Свернуть" Click="OnCollapseClick" />
                    <MenuItem Header="Перезапустить" Click="OnRestartClick" />
                    <Separator />
                    <MenuItem Header="Выход" Click="OnExitClick" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
              <Grid x:Name="CollapsedContent"
                    Width="210" Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <!-- Collapsed: icon rail (same geometry & highlight as the expanded rail) -->
                <StackPanel x:Name="RailCollapsed"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowRail, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource IconButton}" Width="32" Height="30" ToolTip="Музыка"
                            Command="{Binding OpenSectionCommand}" CommandParameter="Music">
                        <Path Data="{StaticResource IconMusic}" Style="{StaticResource Icon}" Width="17" Height="17"
                              Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=Music}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="4,0,0,0" ToolTip="Буфер обмена"
                            Command="{Binding OpenSectionCommand}" CommandParameter="Clipboard">
                        <Path Data="{StaticResource IconClipboard}" Style="{StaticResource Icon}" Width="17" Height="17"
                              Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=Clipboard}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="4,0,0,0" ToolTip="Скриншоты"
                            Command="{Binding OpenSectionCommand}" CommandParameter="Screenshots">
                        <Path Data="{StaticResource IconScreenshots}" Style="{StaticResource Icon}" Width="17" Height="17"
                              Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=Screenshots}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="4,0,0,0" ToolTip="Переводчик"
                            Command="{Binding OpenSectionCommand}" CommandParameter="Translator">
                        <TextBlock Text="文A" FontSize="12"
                                   Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=Translator}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="4,0,0,0" ToolTip="Пипетка"
                            Command="{Binding OpenSectionCommand}" CommandParameter="ColorPicker">
                        <Path Data="{StaticResource IconColorPicker}" Style="{StaticResource Icon}" Width="17" Height="17"
                              Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=ColorPicker}" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="8,0,0,0" ToolTip="Развернуть"
                            Click="OnExpandClick">
                        <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource Icon}" Width="12" Height="12"
                              Stroke="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>

                <!-- Collapsed: mini player -->
                <Grid x:Name="MiniPlayer" Margin="12,0"
                      Visibility="{Binding ShowMiniPlayer, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="30" Height="30" VerticalAlignment="Center">
                        <Border CornerRadius="8" Background="#22FFFFFF">
                            <Path Data="{StaticResource IconMusic}" Style="{StaticResource Icon}" Width="14" Height="14"
                                  Stroke="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Music.Track.Artwork}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Music.Track.DisplayTitle}"
                                   FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Music.Track.DisplayArtist}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <views:Equalizer x:Name="CollapsedEqualizer"
                                     Grid.Column="2"
                                     VerticalAlignment="Center"
                                     IsPlaying="{Binding Music.Track.IsPlaying}" />

                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="6,0,0,0"
                            ToolTip="Развернуть" Click="OnExpandClick">
                        <Path Data="{StaticResource IconChevronDown}" Style="{StaticResource Icon}" Width="12" Height="12"
                              Stroke="{StaticResource TextSecondaryBrush}" />
                    </Button>
                </Grid>
              </Grid>

                <!-- Expanded -->
                <Grid x:Name="ExpandedContent"
                      Margin="8,4,8,8"
                      Visibility="Hidden"
                      Opacity="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Section rail -->
                    <StackPanel x:Name="SectionRail" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button Style="{StaticResource IconButton}" Width="32" Height="30" ToolTip="Музыка"
                                Command="{Binding OpenSectionCommand}" CommandParameter="Music">
                            <Path Data="{StaticResource IconMusic}" Style="{StaticResource Icon}" Width="17" Height="17"
                                  Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=Music}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="4,0,0,0" ToolTip="Буфер обмена"
                                Command="{Binding OpenSectionCommand}" CommandParameter="Clipboard">
                            <Path Data="{StaticResource IconClipboard}" Style="{StaticResource Icon}" Width="17" Height="17"
                                  Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=Clipboard}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="4,0,0,0" ToolTip="Скриншоты"
                                Command="{Binding OpenSectionCommand}" CommandParameter="Screenshots">
                            <Path Data="{StaticResource IconScreenshots}" Style="{StaticResource Icon}" Width="17" Height="17"
                                  Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=Screenshots}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="4,0,0,0" ToolTip="Переводчик"
                                Command="{Binding OpenSectionCommand}" CommandParameter="Translator">
                            <TextBlock Text="文A" FontSize="12"
                                       Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=Translator}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="4,0,0,0" ToolTip="Пипетка"
                                Command="{Binding OpenSectionCommand}" CommandParameter="ColorPicker">
                            <Path Data="{StaticResource IconColorPicker}" Style="{StaticResource Icon}" Width="17" Height="17"
                                  Opacity="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqualsToOpacity}, ConverterParameter=ColorPicker}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="32" Height="30" Margin="8,0,0,0" ToolTip="Свернуть"
                                Click="OnCollapseClick">
                            <Path Data="{StaticResource IconChevronUp}" Style="{StaticResource Icon}" Width="12" Height="12"
                                  Stroke="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- Content surface -->
                    <Border x:Name="ContentSurface" Grid.Row="1" Style="{StaticResource Surface}" ClipToBounds="True">
                        <Grid x:Name="ContentInner">
                            <!-- Selected section -->
                            <Grid x:Name="DetailHost">
                                <views:MusicView x:Name="MusicSection"
                                                 DataContext="{Binding Music}"
                                                 VerticalAlignment="Center" />
                                <views:ClipboardView x:Name="ClipboardSection"
                                                     DataContext="{Binding Clipboard}"
                                                     Visibility="Hidden"
                                                     Opacity="0" />
                                <views:ScreenshotsView x:Name="ScreenshotsSection"
                                                       DataContext="{Binding Screenshots}"
                                                       VerticalAlignment="Top"
                                                       Visibility="Hidden"
                                                       Opacity="0" />
                                <views:TranslatorView x:Name="TranslatorSection"
                                                         DataContext="{Binding Translator}"
                                                         Visibility="Hidden"
                                                         Opacity="0" />
                                <views:ColorPickerView x:Name="ColorPickerSection"
                                                       DataContext="{Binding ColorPicker}"
                                                       Visibility="Hidden"
                                                       Opacity="0" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
